{
  "name": "skill-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Skill Atlas: every SKILL.md in a repository, in the terminal or a local web view.",
  "type": "module",
  "bin": {
    "skill-atlas": "src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo": "node demo/record.ts",
    "test:visual": "playwright test",
    "record": "node scripts/record-claude.ts tests/claude.json demo/claude.json"
  },
  "dependencies": {
    "marked": "^18.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2"
  }
}
